# 复制这个文件为 .env，填上你自己的值。.env 不会被提交。

# --- Claude（提价格 / 写标题和描述）---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# 可选，默认 claude-sonnet-4-6
# CLAUDE_MODEL=claude-sonnet-4-6

# --- 本地 Whisper（语音转文字）---
# 模型越大越准也越慢：tiny / base / small / medium / large-v3
WHISPER_MODEL=small
# 有 NVIDIA 显卡可设 cuda 提速；默认 auto(=cpu/int8)
# WHISPER_DEVICE=auto

# --- 切段的暗号（逗号分隔，可不填用默认：下一件,下一个,下一样,下一款）---
# TRIGGERS=下一件,下一个

# --- 每件挑几张图 ---
# FRAMES_PER_ITEM=5

# --- 商品里写死的联系方式（你的微信号）---
CONTACT=你的微信号

# --- 微信云开发（只有 publish.py 用得到）---
# AppID/AppSecret 在 mp.weixin.qq.com → 开发管理 → 开发设置
WX_APPID=wxxxxxxxxxxxxxxxxx
WX_APPSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 云开发环境 ID（云开发控制台左上角，形如 baby-resale-2xxxxx）
WX_ENV_ID=your-env-id

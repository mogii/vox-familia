# 复制为 .env 后填上你自己的值。.env 不会被提交。

# --- Claude（提价格 / 写标题和描述）---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# 可选：默认 claude-sonnet-4-6
# CLAUDE_MODEL=claude-sonnet-4-6

# --- 本地 Whisper（语音转文字）---
# tiny / base / small / medium / large-v3
WHISPER_MODEL=small
# 有 NVIDIA 显卡可改 cuda；Mac 上一般用 auto(=cpu/int8)
# WHISPER_DEVICE=auto

# --- 切段暗号（逗号分隔；不填用默认: 下一件,下一个,下一样,下一款）---
# TRIGGERS=下一件,换一个

# --- 每件挑几张图 ---
# FRAMES_PER_ITEM=5

# --- 商品里默认写的联系方式（你的微信号）---
CONTACT=你的微信号

# --- Web 服务（server.py）---
# 0.0.0.0 = 同 Wi-Fi 都能访问；只允许 localhost 改成 127.0.0.1
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# 共享密钥；手机端的快捷方式里要带上这个 token。留空 = 不校验（仅推荐在你完全可控的家庭 Wi-Fi 上）
SERVER_TOKEN=随便填一个长一点的字符串
# 处理过的视频和图片放哪儿（相对 processor/ 目录）
JOBS_DIR=jobs

# --- 海报字体（中文必须）---
# Mac 自带的字体里挑一个；多个用 : 分隔，按顺序找第一个存在的
# POSTER_FONT=/System/Library/Fonts/PingFang.ttc:/System/Library/Fonts/Hiragino Sans GB.ttc

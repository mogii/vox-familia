.mine {
  padding: 20rpx 20rpx 140rpx;
  min-height: 100vh;
}

.row {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.row-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #eee;
  flex-shrink: 0;
}

.row-main {
  flex: 1;
  padding: 0 20rpx;
  min-width: 0;
}

.row-title {
  font-size: 28rpx;
  color: #222;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.row-price {
  margin-top: 12rpx;
  color: #ff5a2c;
  font-size: 32rpx;
  font-weight: 600;
}

.row-cond {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #999;
  font-weight: 400;
}

.row-status {
  margin-top: 12rpx;
  font-size: 22rpx;
  display: inline-block;
}

.row-status.on {
  color: #4caf7d;
}

.row-status.sold {
  color: #999;
}

.row-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex-shrink: 0;
}

.act {
  margin: 6rpx 0;
  font-size: 24rpx;
}

.act-sold {
  background: #fff0e9;
  color: #ff5a2c;
}

.act-restore {
  background: #e8f7ef;
  color: #4caf7d;
}

.act-del {
  background: #fff;
  color: #e64340;
  border: 1rpx solid #eee;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
}

.empty-emoji {
  font-size: 96rpx;
}

.empty-text {
  margin-top: 20rpx;
  color: #555;
  font-size: 30rpx;
}

.btn-go-publish {
  margin-top: 36rpx;
  background: #ff7a45;
  color: #fff;
  font-size: 28rpx;
  border-radius: 44rpx;
  padding: 0 60rpx;
}

.float-publish {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: 50rpx;
  background: #ff7a45;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 50rpx;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 69, 0.4);
}

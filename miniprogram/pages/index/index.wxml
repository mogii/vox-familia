<view class="page">
  <view wx:if="{{products.length === 0 && !loading}}" class="empty">
    <text class="empty-emoji">🍼</text>
    <text class="empty-text">还没有在售的闲置</text>
    <text class="empty-sub">过会儿再来看看吧~</text>
  </view>

  <view class="grid">
    <view
      class="card"
      wx:for="{{products}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="goDetail"
    >
      <image class="card-img" src="{{item.images[0]}}" mode="aspectFill" lazy-load="true"></image>
      <view class="card-body">
        <view class="card-title">{{item.title}}</view>
        <view class="card-meta">
          <text class="price">${{item.price}}</text>
          <text class="condition">{{item.condition}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:if="{{!hasMore && products.length > 0}}" class="nomore">没有更多了</view>
</view>

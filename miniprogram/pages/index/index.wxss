.page {
  padding: 20rpx 20rpx 120rpx;
  min-height: 100vh;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card {
  width: 48.5%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-img {
  width: 100%;
  height: 340rpx;
  background: #eee;
  display: block;
}

.card-body {
  padding: 16rpx 18rpx 22rpx;
}

.card-title {
  font-size: 28rpx;
  color: #222;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-meta {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price {
  color: #ff5a2c;
  font-size: 34rpx;
  font-weight: 600;
}

.condition {
  font-size: 22rpx;
  color: #888;
  background: #f1f1f1;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
}

.empty-emoji {
  font-size: 96rpx;
}

.empty-text {
  margin-top: 20rpx;
  color: #555;
  font-size: 30rpx;
}

.empty-sub {
  margin-top: 12rpx;
  color: #aaa;
  font-size: 24rpx;
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: 60rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #ff7a45;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 69, 0.45);
}

.fab-plus {
  font-size: 44rpx;
  line-height: 44rpx;
}

.fab-text {
  font-size: 20rpx;
  margin-top: 2rpx;
}

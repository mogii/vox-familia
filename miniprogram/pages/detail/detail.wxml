<view wx:if="{{loading}}" class="loading">加载中...</view>

<view wx:if="{{product}}" class="detail">
  <swiper class="banner" indicator-dots="{{product.images.length > 1}}" circular="true">
    <swiper-item wx:for="{{product.images}}" wx:key="*this">
      <image
        class="banner-img"
        src="{{item}}"
        mode="aspectFill"
        data-index="{{index}}"
        bindtap="previewImage"
      ></image>
    </swiper-item>
  </swiper>

  <view class="info">
    <view class="price-row">
      <text class="price">${{product.price}}</text>
      <text wx:if="{{product.status === 'sold'}}" class="sold-badge">已售出</text>
      <text class="condition">{{product.condition}}</text>
    </view>
    <view class="title">{{product.title}}</view>
    <view wx:if="{{product.desc}}" class="desc">{{product.desc}}</view>
  </view>

  <view class="contact-card">
    <view class="contact-head">
      <text class="contact-label">联系卖家</text>
      <button class="btn-copy" size="mini" bindtap="copyContact">复制</button>
    </view>
    <view class="contact-value">{{product.contact}}</view>
    <view class="contact-tip">看中了就照上面的方式联系卖家，微信直接转账即可~</view>
  </view>

  <view wx:if="{{isOwner}}" class="owner-actions">
    <button wx:if="{{product.status !== 'sold'}}" class="btn btn-sold" bindtap="markSold">标记已售出</button>
    <button wx:else class="btn btn-restore" bindtap="markAvailable">恢复在售</button>
    <button class="btn btn-delete" bindtap="remove">删除</button>
  </view>

  <view class="bottom-bar">
    <button class="btn-share" open-type="share">分享到微信群</button>
  </view>
</view>

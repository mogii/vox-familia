.detail {
  padding-bottom: 160rpx;
}

.banner {
  width: 100%;
  height: 720rpx;
  background: #eee;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.info {
  background: #fff;
  padding: 28rpx 30rpx;
}

.price-row {
  display: flex;
  align-items: center;
}

.price {
  color: #ff5a2c;
  font-size: 48rpx;
  font-weight: 700;
}

.sold-badge {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #fff;
  background: #999;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.condition {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #888;
  background: #f1f1f1;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}

.title {
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #222;
}

.market {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  background: #fff7f3;
  border-radius: 10rpx;
  padding: 12rpx 18rpx;
}

.market-label {
  font-size: 24rpx;
  color: #999;
}

.market-price {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #999;
  text-decoration: line-through;
}

.market-src {
  margin-left: auto;
  font-size: 24rpx;
  color: #ff7a45;
}

.desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  white-space: pre-wrap;
}

.contact-card {
  margin-top: 20rpx;
  background: #fff;
  padding: 28rpx 30rpx;
}

.contact-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.contact-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.btn-copy {
  margin: 0;
  background: #fff0e9;
  color: #ff5a2c;
  font-size: 24rpx;
}

.contact-value {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: #ff5a2c;
  word-break: break-all;
}

.contact-tip {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #aaa;
  line-height: 1.6;
}

.owner-actions {
  display: flex;
  margin-top: 20rpx;
  padding: 0 20rpx;
}

.btn {
  flex: 1;
  margin: 0 10rpx;
  font-size: 28rpx;
  border-radius: 44rpx;
}

.btn-sold {
  background: #ff7a45;
  color: #fff;
}

.btn-restore {
  background: #4caf7d;
  color: #fff;
}

.btn-delete {
  background: #fff;
  color: #e64340;
  border: 1rpx solid #e64340;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.btn-share {
  background: #ff7a45;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}

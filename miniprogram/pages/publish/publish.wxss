.publish {
  padding: 20rpx 0 60rpx;
}

.section {
  background: #fff;
  margin-bottom: 20rpx;
  padding: 28rpx 30rpx;
}

.sec-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
}

.img-item,
.img-add {
  width: 200rpx;
  height: 200rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 12rpx;
  position: relative;
}

.thumb {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.img-del {
  position: absolute;
  top: -14rpx;
  right: -14rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 30rpx;
}

.img-add {
  border: 2rpx dashed #ccc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #aaa;
}

.add-plus {
  font-size: 52rpx;
  line-height: 52rpx;
}

.add-text {
  font-size: 22rpx;
  margin-top: 8rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.field:last-child {
  border-bottom: none;
}

.label {
  width: 150rpx;
  font-size: 28rpx;
  color: #333;
}

.input {
  flex: 1;
  font-size: 28rpx;
}

.unit {
  color: #999;
  font-size: 26rpx;
}

.picker-wrap {
  flex: 1;
}

.picker {
  font-size: 28rpx;
  color: #333;
}

.textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.submit {
  margin: 40rpx 30rpx 0;
  background: #ff7a45;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
}

.submit[disabled] {
  background: #ffc4ab;
  color: #fff;
}
